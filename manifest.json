{
  "manifest_version": 3,
  "name": "Jamarkup",
  "version": "1.0.0",
  "description": "Click a section, write the change, copy a prompt an AI can apply. Nothing is uploaded.",
  "homepage_url": "https://github.com/MinKaizen/jamarkup",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle Jamarkup dock",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["markdown.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
